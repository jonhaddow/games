{
	"name": "games",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync && node scripts/gen-types.ts || echo ''",
		"check": "node scripts/gen-types.ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:generate": "drizzle-kit generate",
		"gen": "node scripts/gen-types.ts",
		"db:migrate:local": "wrangler d1 migrations apply games --local",
		"db:migrate:remote": "wrangler d1 migrations apply games --remote",
		"deploy": "npm run build && npm run deploy:ci",
		"deploy:ci": "wrangler d1 migrations apply games --remote && wrangler deploy",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@libsql/client": "^0.18.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-cloudflare": "^9.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"@types/three": "^0.187.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.2.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.7",
		"vitest": "^5.1.1",
		"wrangler": "^4.166.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.1": true,
		"esbuild@0.18.20": true,
		"workerd@1.20261113.1": true
	},
	"dependencies": {
		"@fontsource-variable/big-shoulders-stencil": "^5.3.0",
		"@fontsource-variable/pixelify-sans": "^5.3.0",
		"@fontsource/bungee": "^5.3.0",
		"@fontsource/luckiest-guy": "^5.3.0",
		"@fontsource/press-start-2p": "^5.3.0",
		"@fontsource/russo-one": "^5.3.0",
		"three": "^0.187.0"
	}
}
