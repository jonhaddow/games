{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "games",
	"compatibility_date": "2026-11-15",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"routes": [{ "pattern": "games.app.haddow.me", "custom_domain": true }],
	// Keeps request logs and console output (Workers Logs, free tier) for debugging.
	"observability": {
		"enabled": true
	},
	// Off: branch previews would share the live D1 database.
	"preview_urls": false,
	"d1_databases": [
		{
			// Created with --jurisdiction eu, so the data stays in the EU.
			"binding": "DB",
			"database_name": "games",
			"database_id": "f60a470f-a900-4a0d-9eaf-8886978b7ed7",
			"migrations_dir": "drizzle"
		}
	]
}
